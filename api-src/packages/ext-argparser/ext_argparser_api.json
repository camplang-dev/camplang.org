        }
      ],
      "metadata": [
        {
          "name": "summary",
          "content": "Returns true during the parser\u0027s final completion step.\n\nMost applications do not need to call this directly; it is useful when a parser callback wants to run its own final validation after all arguments and inserted arguments have been processed."
        }
      ]
    },
